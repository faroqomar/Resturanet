{
  "name": "resturanet",
  "version": "1.0.0",
  "private": true,
  "description": "نظام سطح مكتب محلي لإدارة حسابات المطعم",
  "main": "out/main/index.js",
  "author": "Resturanet",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:mac": "node scripts/package-mac.cjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@fontsource/alexandria": "latest",
    "@fontsource/ibm-plex-sans-arabic": "latest",
    "adm-zip": "latest",
    "better-sqlite3": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "recharts": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/adm-zip": "latest",
    "@types/better-sqlite3": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "latest",
    "electron-builder": "latest",
    "electron-vite": "5.0.0",
    "jsdom": "latest",
    "prettier": "3.9.6",
    "typescript": "latest",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  },
  "build": {
    "appId": "com.resturanet.desktop",
    "productName": "نظام المطعم",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "نظام المطعم ${version}",
      "artifactName": "Resturanet-${version}-${arch}.${ext}"
    }
  }
}
